    {
        "id": "253f330e183f4bd2",
        "type": "function",
        "z": "6ba0ba7f7fb9f284",
        "name": "transfer data to modbus",
        "func": "let lines = msg.payload.medicine_list || [];\n\n// Ensure we always have 8 lines total\nconst MAX_LINES = 8;\nwhile (lines.length < MAX_LINES) {\n    lines.push(\"\");  // pad with blank lines\n}\n\n// Each line = 20 chars, total 8 lines\n// Each Modbus register holds 2 chars (so 10 words/line)\nlet payload = [];\n\nfor (let line of lines.slice(0, MAX_LINES)) {  // only take first 8 lines if more\n    // pad each line to 20 characters (spaces)\n    line = line.padEnd(20, ' ');\n    for (let i = 0; i < 10; i++) {  // 10 registers per line\n        let lo = line.charCodeAt(i * 2) || 32;      // low byte\n        let hi = line.charCodeAt(i * 2 + 1) || 32;  // high byte\n        payload.push((hi << 8) + lo);               // combine into 16-bit\n    }\n}\n\nreturn [{\n    payload: payload,\n    // fc: 16,             // Write Multiple Registers\n    // unitid: 1,\n    // address: 31,        // Start address in your NB Designer\n    // quantity: payload.length\n}];\n\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 810,
        "y": 720,
        "wires": [
            [
                "00327af30425490c",
                "d68ff7e0ed656369"
            ]
        ]
    },
