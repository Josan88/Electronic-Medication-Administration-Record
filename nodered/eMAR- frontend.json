    {
        "id": "5d35bd454123fc8a",
        "type": "function",
        "z": "6ba0ba7f7fb9f284",
        "name": "Send empty value to the registers for the notebook component",
        "func": "// Number of lines and characters per line\nconst numLines = 8;\nconst charsPerLine = 20;\nconst wordsPerLine = charsPerLine / 2;  // 2 chars per word\n\nlet payload = [];\n\nlet data = msg.payload.data || msg.payload;\n\nif (Array.isArray(data) && data[0] === true) {\n    // Fill all registers with space characters (ASCII 32)\n    for (let line = 0; line < numLines; line++) {\n        for (let i = 0; i < wordsPerLine; i++) {\n            let lo = 32; // ' ' (space)\n            let hi = 32; // ' ' (space)\n            payload.push((hi << 8) + lo);\n        }\n    }\n\n    return [{\n        payload: payload,\n        fc: 16,        // Write Multiple Registers\n        unitid: 1,\n        address: 31,   // Starting Modbus address (adjust as needed)\n        quantity: payload.length\n    }];\n}\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 1300,
        "wires": [
            [
                "e80d17ea4c411e03"
            ]
        ]
    },
