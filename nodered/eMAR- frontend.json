    {
        "id": "6611a29998a23566",
        "type": "function",
        "z": "6ba0ba7f7fb9f284",
        "name": "Filter on specific time slot & set servingMedList",
        "func": "// Get saved test time if available, otherwise use incoming payload\nlet testTime = flow.get(\"currentTime\");\nlet filterTime = testTime ;//|| msg.payload;\n\n// Get stored medication records\nlet feeds = flow.get(\"currentPatientMeds\");\n\nif (Array.isArray(feeds) && feeds.length > 0 && filterTime) {\n\n    // Convert injected time to minutes (supports number, ISO date, or string)\n    let now = new Date();\n    if (typeof filterTime === \"string\") {\n        // let [h, m] = injectedTimestamp.split(\":\").map(x => parseInt(x, 10));\n        // now = new Date();\n        // now.setHours(h || 0, m || 0, 0, 0);\n        if (filterTime) {\n            const [h, m] = filterTime.split(\":\");\n            now.setHours(Number(h), Number(m), 0, 0);\n        }\n        flow.set(\"currentTime\", \"\");\n\n    } else {\n        now = new Date(filterTime);\n    }\n\n    let currentHour = now.getHours();\n    let currentMin = now.getMinutes();\n    let currentTime = currentHour * 60 + currentMin;\n\n    // Convert time format hh:mm to total minutes\n    function timeToMinutes(t) {\n        if (!t) return -1;\n        let [hour, minute] = t.split(\":\").map(v => parseInt(v.trim(), 10));\n        return (hour * 60 + (minute || 0));\n    }\n\n    // Filter meds matching the current time slot\n    let meds = feeds.filter(f => {\n        // Split multiple slots: \"09:00, 13:00, 17:00, 21:00\"\n        let slots = f.time_slot.split(\",\").map(s => s.trim());\n\n        // Convert each to minutes\n        let slotMinutes = slots.map(timeToMinutes);\n\n        // Match if current time equals any slot time\n        return slotMinutes.includes(currentTime);\n        \n        // let slotTime = timeToMinutes(f.time_slot);\n        // return slotTime === currentTime && f.medicine && f.dosage;\n    });\n\n    if (meds.length > 0) {\n        let medList = meds.map(m => `${m.medicine} - ${m.dosage}`);\n        flow.set(\"servingMedList\", meds);\n        node.warn(\"Sending data over\");\n\n        msg.payload = {\n            medicine_list: medList\n        };\n    } else {\n        msg.payload = {\n            source_time: filterTime,\n            current_time: `${currentHour}:${currentMin.toString().padStart(2, \"0\")}`,\n            medicine_list: [\"No medications found for this exact time slot\"]\n        };\n    }\n\n} else {\n    msg.payload = [\"No valid data received or invalid timestamp\"];\n}\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 720,
        "wires": [
