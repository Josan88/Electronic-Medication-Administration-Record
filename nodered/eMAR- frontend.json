    {
        "id": "f000f1f271cd64fc",
        "type": "function",
        "z": "6ba0ba7f7fb9f284",
        "name": "Get Specific paitent with medication info that is within the dates",
        "func": "let feeds = msg.payload.feeds;\nlet targetPatient = flow.get(\"patientID\") || \"UNKNOWN\";\nnode.warn(\"Stored Patient ID: \" + flow.get(\"patientID\"));\nlet data = [];\n\nif (feeds && feeds.length > 0) {\n    let todayStr = flow.get(\"currentDate\");\n\n    if (!todayStr || todayStr.trim() === \"\") {\n        // If no custom date stored, use system date\n        todayStr = new Date().toISOString().split(\"T\")[0];\n        node.warn(\"No currentDate in flow — using system date: \" + todayStr);\n    } \n    else\n    {\n        flow.set(\"currentDate\", \"\");\n    }\n    //let todayStr = today.toISOString().split(\"T\")[0]; // yyyy-mm-dd\n\n    node.warn(\"Filtering for patient: \" + targetPatient + \" on \" + todayStr);\n\n    feeds.forEach(f => {\n        if (f.field1 && f.field2 && f.field3 && f.field4 && f.field5 && f.field6 && f.field7) {\n\n            let record = {\n                patient_id: f.field1,\n                medicine: f.field2,\n                dosage: f.field3,\n                frequency: f.field4,\n                start_date: f.field5,\n                end_date: f.field6,\n                time_slot: f.field7\n            };\n\n            if (f.field1 === targetPatient) {\n                // let startDate = f.field5;\n                // let endDate = f.field6;\n                let startDate = f.field5;\n                let endDate = f.field6;\n\n                let today = new Date(todayStr.trim());\n                let start = new Date(startDate.trim());\n                let end = new Date(endDate.trim());\n               if (today >= start && today <= end) {\n                    data.push(record);\n                }\n            }\n        }\n    });\n} else {\n    node.warn(\"No valid data fetched from ThingSpeak\");\n}\n\nmsg.payload = data;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
