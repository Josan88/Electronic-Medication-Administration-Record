    {
        "id": "f3fd51a315099954",
        "type": "function",
        "z": "6ba0ba7f7fb9f284",
        "name": "Send served medication info to Medicine_Prescription_Track ",
        "func": "let meds = flow.get(\"servingMedList\") || [];\n\nlet data = msg.payload.data || msg.payload;\n\nif (Array.isArray(data) && data[0] === true && meds.length > 0) {\n    node.warn(\"Sending served status\");\n    let now = new Date();\n    now.setHours(now.getHours() + 8);\n    let localDateTime = now.toISOString().replace(\"T\", \" \").substring(0, 19);\n\n    if (!Array.isArray(meds) || meds.length === 0) {\n        node.error(\"No records found in servingMedList\");\n        return null;\n    }\n\n    // Each record is expected to have: patient_id, medicine, dosage, time_slot, etc.\n    let msgs = meds.map(record => ({\n        payload: {\n            api_key: \"LOFTBPN6E2O124FE\",\n            field1: record.patient_id,\n            field2: record.medicine,\n            field3: record.dosage,\n            field4: localDateTime,\n            field5: record.time_slot\n        },\n        method: \"GET\",\n        url: \"https://api.thingspeak.com/update\"\n    }));\n\n    return [msgs];\n}\n\nreturn null;\n\n",
