    {
        "id": "7e6715f1c6441c03",
        "type": "function",
        "z": "dfcc31c8c6e4ade5",
        "name": "Convert bit value to string",
        "func": "// Decode 10 holding registers (each with two ASCII characters)\nlet idNum = msg.payload.data;\n\n// Check if all values are 0\nlet allEmpty = idNum.every(v => v === 0 || v === 8224);\nif (allEmpty) {\n    //node.warn(\"⚠️ All ID registers are empty (0 or 8224) — ignoring update.\");\n    return null; // do not send anything forward\n}\n\nlet text = \"\";\n\nfor (let i = 0; i < idNum.length; i++) {\n    let val = idNum[i];\n    // interpret low byte first, then high byte\n    let low = (val >> 8) & 0xFF;   // swapped positions!\n    let high = val & 0xFF;\n\n    if (high > 0) text += String.fromCharCode(high);\n    if (low > 0) text += String.fromCharCode(low);\n}\n\n// Trim trailing nulls and spaces\nmsg.payload = text.trim();\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 260,
        "wires": [
