    {
        "id": "8cf2a470973c11bb",
        "type": "function",
        "z": "c7fc8cde013689f2",
        "name": "Calculate KPIs",
        "func": "// 1. Get all three data sources\nvar patientData = global.get(\"patient_data\") || { feeds: [] };\nvar scheduledDoses = global.get(\"prescription_data\") || { feeds: [] };\nvar actualDoses = global.get(\"track_data\") || { feeds: [] };\n\n// 2. Get Floor Selection\nvar selectedFloor = flow.get(\"selected_floor\") || \"All Floors\";\n\n// --- SAFETY CHECK ---\nif (scheduledDoses.feeds.length === 0 || patientData.feeds.length === 0) {\n  return null; // Stop flow if no prescription or patient data\n}\n\n// 3. --- NEW: Create Patient-to-Floor Lookup Map ---\n// This \"joins\" the patient data with the prescription data.\nvar patientFloorMap = {};\nfor (var patient of patientData.feeds) {\n  var patientID = patient.field1; // e.g., \"PID-101\"\n  var floor = patient.field3;     // e.g., \"Floor 1\"\n  patientFloorMap[patientID] = floor;\n}\n// patientFloorMap now looks like: {\"PID-101\": \"Floor 1\", \"PID-102\": \"Floor 1\", ...}\n\n// 4. Define KPI variables\nvar totalScheduled = 0;\nvar totalAdministered = 0;\nvar totalDelayInMinutes = 0;\nvar missedDoseAlerts = [];\nvar administeredDoseIds = new Set(); // To prevent double-counting\n\n// 5. --- CORE LOGIC ---\n// Loop through each SCHEDULED dose\nfor (var sched of scheduledDoses.feeds) {\n  var patientID = sched.field1;\n\n  // --- NEW: Find the floor for this patient using the map ---\n  var floorID = patientFloorMap[patientID] || \"Unknown\"; // Get floor from map\n  \n  // --- UPDATED: Floor Filtering Logic ---\n  if (selectedFloor !== \"All Floors\" && floorID !== selectedFloor) {\n    continue; // Skip this dose, it's not on the selected floor\n  }\n  \n  // --- This dose is on the correct floor, so we process it ---\n  totalScheduled++; \n\n  var medicine = sched.field2;\n  var scheduledDate = sched.field5; // e.g., \"2025-10-28\"\n  var scheduledTimeStr = sched.field7; // e.g., \"08:00\"\n\n  var schedTime = new Date(scheduledDate + \"T\" + scheduledTimeStr + \":00\");\n  \n  // Define a reasonable \"administration window\" (e.g., +/- 6 hours)\n  var windowStart = new Date(schedTime.getTime() - 6 * 3600 * 1000);\n  var windowEnd = new Date(schedTime.getTime() + 6 * 3600 * 1000);\n\n  var hasBeenAdministered = false;\n  var bestMatchDelay = Infinity; \n\n  // Loop through the ACTUAL doses to find the best match\n  for (var actual of actualDoses.feeds) {\n    \n    if (administeredDoseIds.has(actual.entry_id)) {\n      continue; // Skip, already used\n    }\n    \n    if (actual.field1 === patientID && actual.field2 === medicine) {\n      var actualTime = new Date(actual.created_at);\n\n      if (actualTime >= windowStart && actualTime <= windowEnd) {\n        var delay = (actualTime.getTime() - schedTime.getTime()) / 60000; // Delay in minutes\n        \n        if (Math.abs(delay) < Math.abs(bestMatchDelay)) {\n          bestMatchDelay = delay;\n          administeredDoseIds.add(actual.entry_id); \n          hasBeenAdministered = true;\n        }\n      }\n    }\n  } // end of inner loop (actual)\n\n  // 6. --- PROCESS RESULTS ---\n  if (hasBeenAdministered) {\n    totalAdministered++;\n    if (bestMatchDelay > 0) { \n      totalDelayInMinutes += bestMatchDelay;\n    }\n  } else {\n    missedDoseAlerts.push({\n      \"Patient\": patientID,\n      \"Medicine\": medicine,\n      \"Time\": scheduledDate + \" \" + scheduledTimeStr,\n      \"Floor\": floorID\n    });\n  }\n\n} // end of outer loop (scheduled)\n\n// 7. --- CALCULATE FINAL KPIs ---\nvar adherence = (totalScheduled > 0) ? (totalAdministered / totalScheduled) * 100 : 0;\nvar avgDelay = (totalAdministered > 0) ? (totalDelayInMinutes / totalAdministered) : 0;\n\n// 8. --- PREPARE OUTPUTS ---\nvar msg1_adherence = { payload: adherence.toFixed(1) };\nvar msg2_avgDelay = { payload: avgDelay.toFixed(1) };\nvar msg3_alerts = { payload: missedDoseAlerts }; \nvar msg4_title = { payload: \"Medication KPIs (\" + selectedFloor + \")\" };\n\n// Ensure your function node is set to 4 outputs.\nreturn [ msg1_adherence, msg2_avgDelay, msg3_alerts, msg4_title ];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 120,
        "wires": [
            [
                "f12a34b5c6d7e8f9"
            ],
            [
                "e9f8d7c6b5a43210"
            ],
            [
                "350e36d8074aaf3e"
            ],
            [
                "de4e64d8611062f6"
            ]
        ]
    },
