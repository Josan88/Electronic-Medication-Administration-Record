        "order": 2,
        "width": 0,
        "height": 0,
        "name": "Avg. Admin Delay",
        "label": "Avg. Admin Delay",
        "format": "{{msg.payload}} minutes",
        "layout": "col-center",
        "style": false,
        "font": "",
        "fontSize": "",
