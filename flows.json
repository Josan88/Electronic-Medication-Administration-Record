    {
        "id": "8cf2a470973c11bb",
        "type": "function",
        "z": "c7fc8cde013689f2",
        "name": "Calculate KPIs",
        "func": "// 1. Get the data we stored\nvar scheduledDoses = global.get(\"prescription_data\") || { feeds: [] };\nvar actualDoses = global.get(\"track_data\") || { feeds: [] };\n\n// --- SAFETY CHECK ---\n// If data isn't loaded yet, stop the flow.\nif (scheduledDoses.feeds.length === 0 || actualDoses.feeds.length === 0) {\n  return null; // Stop flow if no data\n}\n\n// 2. Define KPI variables\nvar totalScheduled = 0;\nvar totalAdministered = 0;\nvar totalDelayInMinutes = 0;\nvar missedDoseAlerts = [];\n\n// 3. --- CORE LOGIC ---\n// Loop through each SCHEDULED dose\nfor (var sched of scheduledDoses.feeds) {\n  var patientID = sched.field1;\n  var medicine = sched.field2;\n  var scheduledTimeStr = sched.field7; // e.g., \"08:00\" \n\n  var hasBeenAdministered = false;\n\n  // Now, loop through the ACTUAL doses to find a match\n  for (var actual of actualDoses.feeds) {\n    var actualTimeStr = actual.field5; // e.g., \"08:05\" \n\n    // Check for a match (same patient, same medicine)\n    if (actual.field1 === patientID && actual.field2 === medicine) {\n\n      // --- Found a match! Calculate delay. ---\n      // This is a simplified example. You'll need more robust date/time parsing.\n      var schedTime = new Date(\"1970-01-01T\" + scheduledTimeStr + \":00\");\n      var actualTime = new Date(\"1970-01-01T\" + actualTimeStr + \":00\");\n\n      var delay = (actualTime.getTime() - schedTime.getTime()) / 60000; // Delay in minutes\n\n      if (delay > 0) { // Only count if administered *after* schedule\n        totalDelayInMinutes += delay;\n      }\n\n      totalAdministered++;\n      hasBeenAdministered = true;\n      break; // Stop inner loop once match is found\n    }\n  } // end of inner loop (actual)\n\n  totalScheduled++;\n\n  // 4. --- GENERATE ALERTS ---\n  // If no match was found after checking all actual doses, it's a missed dose.\n  if (!hasBeenAdministered) {\n    missedDoseAlerts.push({\n      \"Patient\": patientID,\n      \"Medicine\": medicine,\n      \"Time\": scheduledTimeStr\n    });\n  }\n\n} // end of outer loop (scheduled)\n\n// 5. --- CALCULATE FINAL KPIs ---\nvar adherence = (totalAdministered / totalScheduled) * 100;\nvar avgDelay = totalDelayInMinutes / totalAdministered;\n\n// 6. --- PREPARE OUTPUTS ---\n// Create three separate message objects\nvar msg1_adherence = { payload: adherence.toFixed(1) };\nvar msg2_avgDelay = { payload: avgDelay.toFixed(1) };\nvar msg3_alerts = { payload: missedDoseAlerts };\n\n// Return messages to their corresponding outputs\nreturn [ msg1_adherence, msg2_avgDelay, msg3_alerts ];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
